# Local application development defaults.
# Copy to .env.local for local use; do not commit local secrets.

# Backend API defaults to 3100 so port 3000 can be used by other local services.
PORT=3100

# Vite frontend defaults to 5173 and proxies /api/v1 to the backend PORT above.
VITE_FRONTEND_PORT=5173
# Optional explicit override when the backend runs somewhere else.
# VITE_API_PROXY_TARGET=http://localhost:3100
# Deployable demo path uses backend/database-seeded records by default.
# Local fallback is only for explicit offline walkthroughs and must not be used as a silent runtime fallback.
VITE_ENABLE_LOCAL_DEMO_FALLBACK=false
VITE_ENABLE_GUIDED_DEMO=false

# Local PostgreSQL development defaults.
# Runtime persistence can be memory or postgres. Keep memory for fast demos/tests;
# set postgres after migrations and seed have been applied.
PERSISTENCE_ADAPTER=memory
DATABASE_URL=postgres://pls_app:pls_app_password@localhost:5432/pls_platform
DATABASE_SSL_MODE=disable
DB_MIGRATIONS_ENABLED=true
DEMO_SEED_ENABLED=true
