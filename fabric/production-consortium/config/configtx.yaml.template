# PBI-438 production-like local Fabric lab configtx template.
#
# Copy through scripts/fabric/initialize-production-lab-workspace.ps1 so the
# __FABRIC_PRODUCTION_LAB_WORKSPACE__ placeholder is replaced with an external
# workspace path. Do not point MSPDir or TLS cert paths into the repository.

Organizations:
  - &OrdererOrg
    Name: OrdererOrg
    ID: OrdererOrgMSP
    MSPDir: __FABRIC_PRODUCTION_LAB_WORKSPACE__/crypto/ordererOrganizations/consortium.example.test/msp
    Policies:
      Readers:
        Type: Signature
        Rule: "OR('OrdererOrgMSP.member')"
      Writers:
        Type: Signature
        Rule: "OR('OrdererOrgMSP.member')"
      Admins:
        Type: Signature
        Rule: "OR('OrdererOrgMSP.admin')"
    OrdererEndpoints:
      - orderer1.consortium.example.test:7050
      - orderer2.consortium.example.test:8050
      - orderer3.consortium.example.test:9050

  - &PlatformOperator
    Name: PlatformOperatorMSP
    ID: PlatformOperatorMSP
    MSPDir: __FABRIC_PRODUCTION_LAB_WORKSPACE__/crypto/peerOrganizations/platform.example.test/msp
    Policies:
      Readers:
        Type: Signature
        Rule: "OR('PlatformOperatorMSP.admin', 'PlatformOperatorMSP.peer', 'PlatformOperatorMSP.client')"
      Writers:
        Type: Signature
        Rule: "OR('PlatformOperatorMSP.admin', 'PlatformOperatorMSP.client')"
      Admins:
        Type: Signature
        Rule: "OR('PlatformOperatorMSP.admin')"
      Endorsement:
        Type: Signature
        Rule: "OR('PlatformOperatorMSP.peer')"
    AnchorPeers:
      - Host: peer0.platform.example.test
        Port: 7051

  - &Buyer
    Name: BuyerMSP
    ID: BuyerMSP
    MSPDir: __FABRIC_PRODUCTION_LAB_WORKSPACE__/crypto/peerOrganizations/buyer.example.test/msp
    Policies:
      Readers:
        Type: Signature
        Rule: "OR('BuyerMSP.admin', 'BuyerMSP.peer', 'BuyerMSP.client')"
      Writers:
        Type: Signature
        Rule: "OR('BuyerMSP.admin', 'BuyerMSP.client')"
      Admins:
        Type: Signature
        Rule: "OR('BuyerMSP.admin')"
      Endorsement:
        Type: Signature
        Rule: "OR('BuyerMSP.peer')"
    AnchorPeers:
      - Host: peer0.buyer.example.test
        Port: 8051

  - &Supplier
    Name: SupplierMSP
    ID: SupplierMSP
    MSPDir: __FABRIC_PRODUCTION_LAB_WORKSPACE__/crypto/peerOrganizations/supplier.example.test/msp
    Policies:
      Readers:
        Type: Signature
        Rule: "OR('SupplierMSP.admin', 'SupplierMSP.peer', 'SupplierMSP.client')"
      Writers:
        Type: Signature
        Rule: "OR('SupplierMSP.admin', 'SupplierMSP.client')"
      Admins:
        Type: Signature
        Rule: "OR('SupplierMSP.admin')"
      Endorsement:
        Type: Signature
        Rule: "OR('SupplierMSP.peer')"
    AnchorPeers:
      - Host: peer0.supplier.example.test
        Port: 9051

  - &Financier
    Name: FinancierMSP
    ID: FinancierMSP
    MSPDir: __FABRIC_PRODUCTION_LAB_WORKSPACE__/crypto/peerOrganizations/financier.example.test/msp
    Policies:
      Readers:
        Type: Signature
        Rule: "OR('FinancierMSP.admin', 'FinancierMSP.peer', 'FinancierMSP.client')"
      Writers:
        Type: Signature
        Rule: "OR('FinancierMSP.admin', 'FinancierMSP.client')"
      Admins:
        Type: Signature
        Rule: "OR('FinancierMSP.admin')"
      Endorsement:
        Type: Signature
        Rule: "OR('FinancierMSP.peer')"
    AnchorPeers:
      - Host: peer0.financier.example.test
        Port: 10051

  - &RegulatorAuditor
    Name: RegulatorAuditorMSP
    ID: RegulatorAuditorMSP
    MSPDir: __FABRIC_PRODUCTION_LAB_WORKSPACE__/crypto/peerOrganizations/regulatorauditor.example.test/msp
    Policies:
      Readers:
        Type: Signature
        Rule: "OR('RegulatorAuditorMSP.admin', 'RegulatorAuditorMSP.peer', 'RegulatorAuditorMSP.client')"
      Writers:
        Type: Signature
        Rule: "OR('RegulatorAuditorMSP.admin', 'RegulatorAuditorMSP.client')"
      Admins:
        Type: Signature
        Rule: "OR('RegulatorAuditorMSP.admin')"
      Endorsement:
        Type: Signature
        Rule: "OR('RegulatorAuditorMSP.peer')"
    AnchorPeers:
      - Host: peer0.regulatorauditor.example.test
        Port: 11051

Capabilities:
  Channel: &ChannelCapabilities
    V2_0: true
  Orderer: &OrdererCapabilities
    V2_0: true
  Application: &ApplicationCapabilities
    V2_5: true

Channel: &ChannelDefaults
  Policies:
    Readers:
      Type: ImplicitMeta
      Rule: "ANY Readers"
    Writers:
      Type: ImplicitMeta
      Rule: "ANY Writers"
    Admins:
      Type: ImplicitMeta
      Rule: "MAJORITY Admins"
  Capabilities:
    <<: *ChannelCapabilities

Orderer: &OrdererDefaults
  OrdererType: etcdraft
  Addresses:
    - orderer1.consortium.example.test:7050
    - orderer2.consortium.example.test:8050
    - orderer3.consortium.example.test:9050
  EtcdRaft:
    Consenters:
      - Host: orderer1.consortium.example.test
        Port: 7050
        ClientTLSCert: __FABRIC_PRODUCTION_LAB_WORKSPACE__/crypto/ordererOrganizations/consortium.example.test/orderers/orderer1.consortium.example.test/tls/server.crt
        ServerTLSCert: __FABRIC_PRODUCTION_LAB_WORKSPACE__/crypto/ordererOrganizations/consortium.example.test/orderers/orderer1.consortium.example.test/tls/server.crt
      - Host: orderer2.consortium.example.test
        Port: 8050
        ClientTLSCert: __FABRIC_PRODUCTION_LAB_WORKSPACE__/crypto/ordererOrganizations/consortium.example.test/orderers/orderer2.consortium.example.test/tls/server.crt
        ServerTLSCert: __FABRIC_PRODUCTION_LAB_WORKSPACE__/crypto/ordererOrganizations/consortium.example.test/orderers/orderer2.consortium.example.test/tls/server.crt
      - Host: orderer3.consortium.example.test
        Port: 9050
        ClientTLSCert: __FABRIC_PRODUCTION_LAB_WORKSPACE__/crypto/ordererOrganizations/consortium.example.test/orderers/orderer3.consortium.example.test/tls/server.crt
        ServerTLSCert: __FABRIC_PRODUCTION_LAB_WORKSPACE__/crypto/ordererOrganizations/consortium.example.test/orderers/orderer3.consortium.example.test/tls/server.crt
  BatchTimeout: 2s
  BatchSize:
    MaxMessageCount: 10
    AbsoluteMaxBytes: 99 MB
    PreferredMaxBytes: 512 KB
  Organizations:
    - *OrdererOrg
  Policies:
    Readers:
      Type: ImplicitMeta
      Rule: "ANY Readers"
    Writers:
      Type: ImplicitMeta
      Rule: "ANY Writers"
    Admins:
      Type: ImplicitMeta
      Rule: "MAJORITY Admins"
    BlockValidation:
      Type: ImplicitMeta
      Rule: "ANY Writers"
  Capabilities:
    <<: *OrdererCapabilities

Application: &ApplicationDefaults
  Organizations:
  Policies:
    Readers:
      Type: ImplicitMeta
      Rule: "ANY Readers"
    Writers:
      Type: ImplicitMeta
      Rule: "ANY Writers"
    Admins:
      Type: ImplicitMeta
      Rule: "MAJORITY Admins"
    LifecycleEndorsement:
      Type: Signature
      Rule: "OutOf(2, 'PlatformOperatorMSP.peer', 'BuyerMSP.peer', 'SupplierMSP.peer', 'FinancierMSP.peer', 'RegulatorAuditorMSP.peer')"
    Endorsement:
      Type: Signature
      Rule: "OutOf(2, 'PlatformOperatorMSP.peer', 'BuyerMSP.peer', 'SupplierMSP.peer', 'FinancierMSP.peer', 'RegulatorAuditorMSP.peer')"
  Capabilities:
    <<: *ApplicationCapabilities

Profiles:
  ProcurementProofChannel:
    <<: *ChannelDefaults
    Orderer:
      <<: *OrdererDefaults
      Organizations:
        - *OrdererOrg
    Application:
      <<: *ApplicationDefaults
      Organizations:
        - *PlatformOperator
        - *Buyer
        - *Supplier
        - *Financier
        - *RegulatorAuditor
    Consortium: ProcurementProofConsortium
