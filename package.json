{
  "name": "pls-platform",
  "version": "1.0.0",
  "description": "PLS Platform - Sprint 1 Baseline",
  "private": true,
  "type": "module",
  "main": "dist/app/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app/server.js",
    "dev": "node --loader ts-node/esm src/app/server.ts",
    "test": "node scripts/run-tests.mjs",
    "test:backend": "node scripts/run-tests.mjs",
    "frontend:dev": "vite --config vite.config.ts",
    "frontend:build": "tsc -p tsconfig.frontend.json && vite build --config vite.config.ts",
    "frontend:preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "fastify": "^4.26.0",
    "fastify-plugin": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
